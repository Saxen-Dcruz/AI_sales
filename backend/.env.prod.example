# =============================================================================
# backend/.env.prod  — TEMPLATE (no real values)
# =============================================================================
# Copy this file to backend/.env.prod on the PRODUCTION SERVER ONLY and fill in
# the rotated secrets. This file (.env.prod) is git-ignored and must NEVER be
# committed. On the server: `chmod 600 backend/.env.prod`.
#
# All values below are placeholders — replace every <...> with a real secret.
# =============================================================================

# --- AI / Speech provider keys ---
HUGGINGFACEHUB_ACCESS_TOKEN="<rotate-me>"
GUARD_API_KEY="<rotate-me>"
DEEPGRAM_API_KEY="<rotate-me>"
ELEVEN_API_KEY="<rotate-me>"
CARTESIA_API_KEY="<rotate-me>"
GOOGLE_API_KEY="<rotate-me>"

# --- App settings ---
PROJECT_NAME="RDL AI Sales"
ENVIRONMENT=production
LOG_LEVEL=INFO

# Comma/JSON list of allowed CORS origins (pin to your real frontend origin)
BACKEND_CORS_ORIGINS=["https://118-139-165-99.nip.io:8443"]

# --- Security (rotate all of these) ---
SECRET_KEY="<rotate-me>"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_SECRET_KEY="<rotate-me>"
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Database (external PostgreSQL + pgvector via pgbouncer) ---
POSTGRES_USER="<db-user>"
POSTGRES_PASSWORD="<rotate-me>"
POSTGRES_DB="<db-name>"
POSTGRES_SERVER="host.docker.internal"
POSTGRES_PORT=6432

# --- LiveKit ---
LIVEKIT_API_KEY="<rotate-me>"
LIVEKIT_API_SECRET="<rotate-me>"
LIVEKIT_KEYS="<api-key>: <api-secret>"
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_WS_URL=wss://118-139-165-99.nip.io:8443/livekit
