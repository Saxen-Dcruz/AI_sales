# Keep the build context small and secret-free.
.git
.gitignore
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / local env — provided at runtime via env_file, never baked in
.env
.env.*
!.env.prod.example

# Local tooling config (never needed in an image)
.mcp.json
.jcodemunch.jsonc

# Local data & generated artifacts (mounted at runtime, not needed for build)
linkedin_profile_context/
data/
knowledge_base/
*.log

# Credentials that must never enter an image
service-account.json
client_secret*.json
*_token.json
*.pem
*.key
